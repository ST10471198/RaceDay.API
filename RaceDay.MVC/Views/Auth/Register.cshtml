@model RaceDay.MVC.Models.RegisterRequestModel
@{ ViewData["Title"] = "Register"; }

<div class="container mt-5">
    <div class="col-md-6 mx-auto card shadow p-4">
        <h3 class="text-center mb-4">Register</h3>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3"><label>Full Name</label><input asp-for="Name" class="form-control" required /></div>
            <div class="mb-3"><label>Email</label><input asp-for="Email" type="email" class="form-control" required /></div>
            <div class="mb-3"><label>Password</label><input asp-for="Password" type="password" class="form-control" required /></div>
            
            <div class="mb-3">
                <label>Role</label>
                <select asp-for="Role" class="form-select" id="roleSelect">
                    <option value="Participant">Participant</option>
                    <option value="Organiser">Organiser</option>
                </select>
            </div>
            
            <div id="orgFields" style="display:none;">
                <div class="mb-3"><label>Phone</label><input asp-for="Phone" class="form-control" /></div>
            </div>
            
            <div id="partFields">
                <div class="mb-3"><label>Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                <div class="mb-3"><label>ID Number</label><input asp-for="IdNumber" class="form-control" /></div>
                <div class="mb-3"><label>Emergency Contact</label><input asp-for="EmergencyContact" class="form-control" /></div>
            </div>
            
            <button type="submit" class="btn btn-success w-100">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("roleSelect").addEventListener("change", function() {
            let isOrg = this.value === "Organiser";
            document.getElementById("orgFields").style.display = isOrg ? "block" : "none";
            document.getElementById("partFields").style.display = isOrg ? "none" : "block";
        });
    </script>
}