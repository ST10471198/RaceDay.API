@model RaceDay.MVC.Models.ParticipantProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-center p-4">
                @if(!string.IsNullOrEmpty(Model.ProfilePictureUrl)) {
                    <img src="@Model.ProfilePictureUrl" class="rounded-circle mx-auto mb-3" style="width: 150px; height: 150px; object-fit: cover;" />
                } else {
                    <div class="bg-secondary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 150px; height: 150px;">
                        <span class="text-white fs-1">@Model.Name[0]</span>
                    </div>
                }
                <h4>@Model.Name</h4>
                <p class="text-muted">@Model.Email</p>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4>Edit Profile</h4>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    <form asp-action="Profile" method="post" enctype="multipart/form-data">
                        <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" required /></div>
                        <div class="mb-3"><label class="form-label">Emergency Contact</label><input asp-for="EmergencyContact" class="form-control" required /></div>
                        <div class="mb-3"><label class="form-label">Date of Birth</label><input asp-for="DateOfBirth" type="date" class="form-control" required /></div>
                        <div class="mb-3">
                            <label class="form-label">Update Profile Picture</label>
                            <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 