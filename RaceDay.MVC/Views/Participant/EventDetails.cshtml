@model RaceDay.MVC.Models.EventViewModel
@{ ViewData["Title"] = Model.Name; }

<div class="container mt-4">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Events</a>
    </div>

    <!-- ADDED ERROR/SUCCESS MESSAGES HERE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-lg border-0">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="@Model.BannerImageUrl" class="card-img-top" alt="@Model.Name" style="max-height: 400px; object-fit: cover;">
        }
        
        <div class="card-body p-5">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="display-5 fw-bold text-primary">@Model.Name</h1>
                    <h5 class="text-muted mb-4">📍 @Model.Location | 📅 @Model.Date.ToString("dd MMMM yyyy")</h5>
                </div>
                <span class="badge @(Model.Status == "Open" ? "bg-success" : "bg-primary") fs-5 px-3 py-2">
                    @Model.Status
                </span>
            </div>

            <hr />
            
            <h4>About this Event</h4>
            <p class="fs-5">@Model.Description</p>

            <hr />

            <h4>Available Categories</h4>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                <div class="row mt-3">
                    @foreach (var cat in Model.Categories)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card shadow-sm border-info h-100">
                                <div class="card-body text-center">
                                    <h5 class="fw-bold text-info">@cat.Name</h5>
                                    <p class="mb-1"><strong>Distance:</strong> @cat.DistanceKM km</p>
                                    <p class="mb-1"><strong>Fee:</strong> R @cat.EntryFee</p>
                                    <p class="mb-3"><strong>Age Limit:</strong> @cat.AgeMin - @cat.AgeMax</p>
                                    
                                    <form asp-action="Enrol" method="post">
                                        <input type="hidden" name="EventID" value="@Model.EventID" />
                                        <input type="hidden" name="CategoryID" value="@cat.CategoryID" />
                                        <button type="submit" class="btn btn-success w-100 fw-bold">Enrol in this Category</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">No categories have been added to this event yet.</div>
            }
        </div>
    </div>
</div> 