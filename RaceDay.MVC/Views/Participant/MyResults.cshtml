@model List<RaceDay.MVC.Models.ParticipantResultViewModel>
@{ ViewData["Title"] = "My Results"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Race History</h2>
            <p class="text-muted mb-0">Track your performance across all RaceDay events.</p>
        </div>
    </div>
    
    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <i class="bi bi-trophy display-1 text-muted mb-3"></i>
            <h4 class="fw-bold">No Results Yet</h4>
            <p class="text-muted">You don't have any race results yet. Keep training and check back after your next event!</p>
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-primary">Find an Event</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Event Details</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Finish Time</th>
                            <th class="pe-4">Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var res in Model) {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark fs-5">@res.EventName</div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar-event me-1"></i> @res.EventDate.ToString("dd MMM yyyy")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border"><i class="bi bi-tag me-1"></i> @res.CategoryName</span>
                                </td>
                                <td>
                                    <span class="badge @(res.Status == "Finished" ? "bg-success" : "bg-warning text-dark")">
                                        @res.Status
                                    </span>
                                </td>
                                <td>
                                    @if(res.FinishTime.HasValue) {
                                        <span class="fw-bold text-primary"><i class="bi bi-stopwatch me-1"></i> @res.FinishTime.Value.ToString(@"hh\:mm\:ss")</span>
                                    } else {
                                        <span class="text-muted fst-italic">Not recorded</span>
                                    }
                                </td>
                                <td class="pe-4">
                                    @if(res.Position.HasValue) {
                                        <span class="fw-bold fs-5 text-dark">@res.Position.Value<span class="fs-6 text-muted">th</span></span>
                                    } else {
                                        <span class="text-muted fst-italic">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>