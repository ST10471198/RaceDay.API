@model IEnumerable<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Welcome, @ViewBag.UserName</h2>
            <p class="text-muted mb-0">Manage your events, categories, and results.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 text-center p-5">
            <i class="bi bi-calendar-x display-1 text-muted mb-3"></i>
            <h4 class="fw-bold">No Events Found</h4>
            <p class="text-muted">You haven't created any events yet. Click the button above to get started!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                var count = ViewBag.EnrolmentCounts.ContainsKey(ev.EventID) ? ViewBag.EnrolmentCounts[ev.EventID] : 0;
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card event-card shadow-sm h-100">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 180px;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 180px; border-top-left-radius: 12px; border-top-right-radius: 12px;">
                                <i class="bi bi-image fs-1"></i>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@ev.Name</h5>
                                <span class="badge @(ev.Status == "Open" ? "bg-success" : "bg-warning text-dark")">@ev.Status</span>
                            </div>

                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @ev.Location</p>
                            <p class="text-muted small mb-3"><i class="bi bi-calendar-event text-primary me-1"></i> @ev.Date.ToString("dd MMM yyyy")</p>

                            <div class="d-flex align-items-center bg-light rounded p-2 mb-2">
                                <i class="bi bi-people-fill text-primary fs-4 me-2 ms-1"></i>
                                <div>
                                    <span class="d-block fw-bold fs-5 lh-1">@count</span>
                                    <span class="text-muted small">Enrolments</span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 pt-0">
                            <div class="row g-2">
                                <div class="col-6">
                                    <a asp-action="ManageCategories" asp-route-eventId="@ev.EventID" class="btn btn-outline-secondary btn-sm w-100">Categories</a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-outline-info btn-sm w-100 text-dark">Enrolments</a>
                                </div>
                                <div class="col-6">
                                    <a asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-outline-primary btn-sm w-100">Edit</a>
                                </div>
                                <div class="col-6">
                                    <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post" onsubmit="return confirm('Delete this event?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Delete</button>
                                    </form>
                                </div>
                                <div class="col-12 mt-2">
                                    <a asp-action="EnterResults" asp-route-eventId="@ev.EventID" class="btn btn-warning btn-sm w-100 fw-bold text-dark">
                                        <i class="bi bi-stopwatch me-1"></i> Enter Results
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>