@model IEnumerable<RaceDay.MVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Welcome, @ViewBag.UserName</h2>
        <a asp-action="CreateEvent" class="btn btn-success fw-bold shadow-sm">
            + Create New Event
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm border-info">
            <h5 class="alert-heading">No Events Found</h5>
            <p class="mb-0">You haven't created any events yet. Click the <strong>"+ Create New Event"</strong> button above to get started!</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                var count = ViewBag.EnrolmentCounts.ContainsKey(ev.EventID) ? ViewBag.EnrolmentCounts[ev.EventID] : 0;
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100 border-0">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 180px;">
                                <span>No Banner Image</span>
                            </div>
                        }

                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@ev.Name</h5>
                            <p class="card-text text-muted mb-1">📍 @ev.Location</p>
                            <p class="card-text mb-1"><strong>Date:</strong> @ev.Date.ToString("dd MMM yyyy")</p>
                            <p class="card-text mb-3"><strong>Enrolments:</strong> <span class="badge bg-secondary">@count</span></p>

                            @if (ev.Status == "Open")
                            {
                                <span class="badge bg-success">Open</span>
                            }
                            else if (ev.Status == "Upcoming")
                            {
                                <span class="badge bg-primary">Upcoming</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@ev.Status</span>
                            }
                        </div>

                        <div class="card-footer bg-light border-top-0">
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex gap-2">
                                    <a asp-action="ManageCategories" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-secondary w-50">Categories</a>
                                    <a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-info w-50">Enrolments</a>
                                </div>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary w-50">Edit</a>
                                    <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post" class="w-50" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">Delete</button>
                                    </form>
                                </div>
                                <a asp-action="EnterResults" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-warning w-100 fw-bold">Enter Results</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>