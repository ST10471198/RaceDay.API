@model RaceDay.MVC.Models.CreateEventModel
@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Create New Event</h3>
                <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Event Name</label>
                                <input asp-for="Name" class="form-control" placeholder="e.g. Comrades Marathon" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Location</label>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Pietermaritzburg" required />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Provide details about the race..."></textarea>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-4">
                                <label class="form-label">Date</label>
                                <input asp-for="Date" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Max Participants</label>
                                <input asp-for="MaxParticipants" type="number" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Status</label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Open">Open</option>
                                    <option value="Upcoming">Upcoming</option>
                                </select>
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-light rounded border">
                            <label class="form-label text-primary"><i class="bi bi-cloud-arrow-up me-1"></i> Event Banner Image</label>
                            <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted d-block mt-2">This image will be uploaded to Azure Blob Storage and displayed on the event page.</small>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">
                                <i class="bi bi-check-circle me-1"></i> Create Event
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>