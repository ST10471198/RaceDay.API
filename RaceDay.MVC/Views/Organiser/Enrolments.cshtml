@model IEnumerable<RaceDay.MVC.Models.EnrolmentViewModel>
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Enrolments</h3>
            <p class="text-muted mb-0">@ViewBag.EventName</p>
        </div>
        <div>
            <a asp-action="EnterResults" asp-route-eventId="@ViewBag.EventId" class="btn btn-warning fw-bold text-dark shadow-sm me-2">
                <i class="bi bi-stopwatch"></i> Results Entry
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary shadow-sm">
                Back to Dashboard
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 p-5 text-center">
            <i class="bi bi-people display-1 text-muted mb-3"></i>
            <h5 class="fw-bold">No Enrolments Yet</h5>
            <p class="text-muted">No participants have signed up for this event.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Participant Name</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@e.ParticipantName</td>
                            <td>@e.CategoryName</td>
                            <td>
                                <span class="badge @(e.Status == "Finished" ? "bg-success" : "bg-warning text-dark")">
                                    @e.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>