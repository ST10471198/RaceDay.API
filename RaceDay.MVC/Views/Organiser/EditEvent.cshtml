@model RaceDay.MVC.Models.CreateEventModel
@{ ViewData["Title"] = "Edit Event"; }

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Edit Event</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditEvent" asp-route-id="@ViewBag.EventId" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Event Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Date</label>
                        <input asp-for="Date" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Max Participants</label>
                        <input asp-for="MaxParticipants" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Open">Open</option>
                            <option value="Upcoming">Upcoming</option>
                            <option value="Closed">Closed</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Current Banner Image</label><br />
                    @if (!string.IsNullOrEmpty(ViewBag.ExistingImage as string))
                    {
                        <img src="@ViewBag.ExistingImage" alt="Banner" style="max-height: 150px; border-radius: 8px;" class="mb-2" />
                    }
                    else
                    {
                        <p class="text-muted">No image uploaded yet.</p>
                    }
                    <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                    <small class="text-muted">Upload a new image to replace the current one.</small>
                </div>
                
                <div class="d-flex gap-2">
                    <a asp-action="Dashboard" class="btn btn-secondary w-50">Cancel</a>
                    <button type="submit" class="btn btn-success w-50">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div> 